<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Gradient background simile all'app -->
    <gradient
        android:angle="135"
        android:startColor="#4D1E3A4F"
        android:centerColor="#4D152A3D"
        android:endColor="#4D0A1F2E"
        android:type="linear" />
    
    <!-- Bordo -->
    <stroke
        android:width="1.5dp"
        android:color="#33FFFFFF" />
    
    <!-- Angoli arrotondati -->
    <corners android:radius="16dp" />
    
</shape>
